{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/case/new-project", "destination": "/case/ai-learning", "statusCode": 301 },
    { "source": "/case/new-project.html", "destination": "/case/ai-learning", "statusCode": 301 },
    { "source": "/case/new-project/index.html", "destination": "/case/ai-learning", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
